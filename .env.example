# Copy to .env and fill in. Never put real values in this file.

# --- Tooling secrets (local only, never bundled) ---
GITHUB_TOKEN=
SUPABASE_TOKEN=
EXPO_TOKEN=
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=
SUPABASE_SERVICE_ROLE_KEY=

# --- App config (EXPO_PUBLIC_* ships inside the app bundle) ---
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

APP_ENV=development
